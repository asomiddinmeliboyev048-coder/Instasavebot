# Telegram
BOT_TOKEN=replace_me
BOT_USERNAME=
ADMIN_IDS=123456789

# Download limits (Telegram Bot API hosted upload limit is typically 50 MB)
MAX_FILE_SIZE_MB=49
DOWNLOAD_DIR=downloads
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_SECONDS=180

# Zikra / Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ZIKRA_ALLOWED_HOSTS=zikra.uz,www.zikra.uz
ZIKRA_VIDEO_TABLE=reels
ZIKRA_VIDEO_ID_COLUMN=id
ZIKRA_VIDEO_PATH_COLUMN=video_url
ZIKRA_VIDEO_BUCKET_COLUMN=
ZIKRA_STORAGE_BUCKET=videos

# Optional music recognition (AudD)
AUDD_API_TOKEN=

# Logging
LOG_LEVEL=INFO
