# Telegram
BOT_TOKEN=replace_me
BOT_USERNAME=

# Download limits (hosted Telegram Bot API limit is typically 50 MB)
MAX_FILE_SIZE_MB=49
DOWNLOAD_DIR=downloads
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_SECONDS=180

# Optional yt-dlp cookies file for content your account is allowed to access.
# Configure this as a Render Secret File; never commit the cookies file.
YTDLP_COOKIES_FILE=

# Zikra / Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ZIKRA_ALLOWED_HOSTS=zikra.uz,www.zikra.uz
# Zikra Reels are stored in public.reels and video_url contains the public S3 URL.
ZIKRA_VIDEO_TABLE=reels
ZIKRA_VIDEO_ID_COLUMN=id
ZIKRA_VIDEO_PATH_COLUMN=video_url
ZIKRA_VIDEO_BUCKET_COLUMN=
ZIKRA_STORAGE_BUCKET=videos

# Logging
LOG_LEVEL=INFO
