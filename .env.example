# Telegram
BOT_TOKEN=replace_me
BOT_USERNAME=

# Download limits (hosted Telegram Bot API limit is typically 50 MB)
MAX_FILE_SIZE_MB=49
DOWNLOAD_DIR=downloads
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_SECONDS=180

# Optional yt-dlp cookies file for content your account is allowed to access.
# Never commit the cookies file.
YTDLP_COOKIES_FILE=

# Zikra / Supabase
# For direct public/signed Supabase Storage URLs, only SUPABASE_URL is needed
# when the URL itself is already accessible. For private object paths, configure
# the service role key and bucket. Keep the service role key secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ZIKRA_STORAGE_BUCKET=
# Optional: restrict Zikra links to your platform and Supabase hostnames.
ZIKRA_ALLOWED_HOSTS=zikra.uz,www.zikra.uz
# Optional database lookup adapter. Configure only after confirming your schema.
ZIKRA_VIDEO_TABLE=
ZIKRA_VIDEO_ID_COLUMN=id
ZIKRA_VIDEO_PATH_COLUMN=storage_path
ZIKRA_VIDEO_BUCKET_COLUMN=

# Logging
LOG_LEVEL=INFO
